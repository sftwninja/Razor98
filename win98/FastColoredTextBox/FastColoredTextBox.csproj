<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>FastColoredTextBoxNS</RootNamespace>
    <AssemblyName>FastColoredTextBox</AssemblyName>
    <Src>$(MSBuildThisFileDirectory)..\..\FastColoredTextBox\</Src>
    <!-- Razor's resources reference the signed name -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(Src)FCTB_key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Design" />
    <Reference Include="System.Xml" />
    <Compile Include="$(Src)**\*.cs" Exclude="$(Src)obj\**;$(Src)bin\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(Src)**\*.resx" Exclude="$(Src)obj\**;$(Src)bin\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
